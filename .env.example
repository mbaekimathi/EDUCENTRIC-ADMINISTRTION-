# Local development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=

# Production (cPanel subdomain or VPS) — copy and fill in on the server:
# DEBUG=False
# SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=admin.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com
# SECURE_SSL_REDIRECT=True
# USE_PROXY_SSL_HEADER=True
# SERVE_MEDIA=True

# VPS (Gunicorn + Nginx) — prefer these over cPanel defaults:
# SERVE_MEDIA=False
# DB_CONN_MAX_AGE=60
# REDIS_URL=redis://127.0.0.1:6379/1

# Leave DB_NAME blank to use SQLite locally. Set all fields below for MySQL.
# On cPanel use the full names from MySQL Databases (often prefix_dbname / prefix_user).
DB_NAME=my-school-system
DB_USER=root
DB_PASSWORD=
# Local XAMPP: 127.0.0.1. cPanel: usually localhost (socket auto-detected) OR the
# hostname shown in cPanel → MySQL Databases (not always "localhost").
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional. If you get "Can't connect ... localhost (Errno 111)", set the socket
# from the host (common: /var/lib/mysql/mysql.sock or /tmp/mysql.sock).
# Leave blank to auto-detect on Linux; ignored on Windows.
# DB_SOCKET=/var/lib/mysql/mysql.sock

# Optional. Enables shared cache + Redis-backed sessions when set.
# Leave blank on cPanel if Redis is not available.
REDIS_URL=

# Apply pending migrations automatically when the web process loads (default: True).
# On cPanel, failed migrate no longer crashes the app; set False to skip entirely.
AUTO_MIGRATE=True
# AUTO_MIGRATE_TTL=600

# MySQL connection reuse (seconds). Use 0 on cPanel/Passenger (recommended).
# Use 60 on VPS with Gunicorn + health checks.
DB_CONN_MAX_AGE=0
