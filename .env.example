# Local development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Production (cPanel subdomain) — copy and fill in on the server:
# DEBUG=False
# SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=admin.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com
# SECURE_SSL_REDIRECT=True
# USE_PROXY_SSL_HEADER=True
# SERVE_MEDIA=True

# Leave DB_NAME blank to use SQLite locally. Set all fields below for MySQL.
DB_NAME=my-school-system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional. Leave blank on cPanel if Redis is not available.
REDIS_URL=

# Apply pending migrations automatically when the web process loads (default: True).
# On cPanel, failed migrate no longer crashes the app; set False to skip entirely.
AUTO_MIGRATE=True
# AUTO_MIGRATE_TTL=600

# MySQL connection reuse (seconds). Use 0 on cPanel/Passenger (recommended).
DB_CONN_MAX_AGE=0
