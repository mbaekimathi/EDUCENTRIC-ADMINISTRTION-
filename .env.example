# True on your PC; False on cPanel / production
LOCAL=True

SECRET_KEY=replace-with-a-long-random-secret

# --- Local development (LOCAL=True) ---
LOCAL_DEBUG=True
LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOCAL_CSRF_TRUSTED_ORIGINS=
LOCAL_SECURE_SSL_REDIRECT=False
LOCAL_USE_PROXY_SSL_HEADER=False
LOCAL_SERVE_MEDIA=True
# Leave LOCAL_DB_NAME blank in settings logic uses SQLite — set for local MySQL:
LOCAL_DB_NAME=my-school-system
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=127.0.0.1
LOCAL_AUTO_MIGRATE=True

# --- Hosted production (LOCAL=False) ---
HOSTED_DEBUG=False
HOSTED_ALLOWED_HOSTS=admin.yourdomain.com
HOSTED_CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com
HOSTED_SECURE_SSL_REDIRECT=True
HOSTED_USE_PROXY_SSL_HEADER=True
HOSTED_SERVE_MEDIA=True
# On cPanel use full names from MySQL Databases (often prefix_dbname / prefix_user).
HOSTED_DB_NAME=
HOSTED_DB_USER=
HOSTED_DB_PASSWORD=
# cPanel: usually localhost (socket auto-detected) OR hostname from MySQL Databases.
HOSTED_DB_HOST=localhost
HOSTED_AUTO_MIGRATE=False

# VPS (Gunicorn + Nginx) — prefer HOSTED_SERVE_MEDIA=False, DB_CONN_MAX_AGE=60, REDIS_URL=...

DB_PORT=3306
# Optional. If you get "Can't connect ... localhost (Errno 111)", set the socket
# from the host (common: /var/lib/mysql/mysql.sock or /tmp/mysql.sock).
# Leave blank to auto-detect on Linux; ignored on Windows.
# DB_SOCKET=/var/lib/mysql/mysql.sock

# Optional. Enables shared cache + Redis-backed sessions when set.
# Leave blank on cPanel if Redis is not available.
REDIS_URL=

# AUTO_MIGRATE_TTL=600

# MySQL connection reuse (seconds). Use 0 on cPanel/Passenger (recommended).
# Use 60 on VPS with Gunicorn + health checks.
DB_CONN_MAX_AGE=0
